  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.5",
    "@codama/renderers-js": "2.4.0",
    "@types/node": "24.13.3",
    "codama": "1.10.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
