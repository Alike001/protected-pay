    "gate1:simulate:final-withdrawal": "tsx scripts/gate1-simulate-final-withdrawal.ts",
    "gate1:send:final-withdrawal": "tsx scripts/gate1-simulate-final-withdrawal.ts --send",
    "gate1:auth:simulate:private-lock": "tsx scripts/gate1-auth-simulate-private-lock.ts",
