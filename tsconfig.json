{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "target/types/**/*.ts"],
  "exclude": [
    "scripts/gate1-auth-simulate-private-lock.ts",
    "scripts/gate1-send-private-lock.ts",
    "scripts/gate1-simulate-private-lock.ts"
  ]
}
